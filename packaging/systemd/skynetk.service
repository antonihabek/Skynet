[Unit]
# §25's control loop: the process that owns the RHAL driver and the Safety Kernel.
#
# §33.1 is the sentence this file exists to make true rather than merely stated:
#
#   The kernel and the RHAL driver survive a `skynetd` restart. They are separate processes with
#   separate lifetimes; the kernel is started by systemd BEFORE `skynetd` and does not depend on it.
#
# So the ordering lives here, on the unit that must come first, and `skynetd.service` carries the
# matching `After=`. Neither unit `Requires=` the other: a robot with no `skynetd` is a robot that
# holds position safely (§33.1), and a robot with no control loop is one that supervises packages
# and commands nothing — both are states this platform is designed to be in.
Description=Skynet OS control loop (§25)
Documentation=file:/usr/share/doc/skynet/skynet-os-architecture.md
Before=skynetd.service
# The driver is opened at start and the loop cannot run without it. Failing here is loud and the
# robot is left with no commanding process at all, which is the safe direction: nothing writes to
# an actuator until something reads a ring.
After=local-fs.target

[Service]
Type=exec
EnvironmentFile=/etc/skynet/skynetk.env
ExecStart=/usr/bin/skynetk run \
    --driver ${SKYNET_DRIVER} \
    --config ${SKYNET_DRIVER_CONFIG} \
    --tier ${SKYNET_TIER} \
    --hz ${SKYNET_HZ} \
    --blackbox ${SKYNET_ROOT}/data/blackbox \
    --crash-file ${SKYNET_ROOT}/data/state/last-kernel-crash.json \
    --policy-socket ${SKYNET_ROOT}/run/policy.sock \
    --policy-socket-group skynet-ring \
    --source-from ${SKYNET_ROOT}/run/source.json \
    --limits-report ${SKYNET_ROOT}/run/kernel-limits.json

# §93: the plan reaches the loop. `skynetd` leaves the commanding package's source embodiment at
# `run/source.json` before that package starts, and removes it when no package commands; this
# process reads it when a policy connects for the rings and resolves the plan itself, with the
# planner `skynetd` runs. Nothing else crosses, and `skynetd` never touches the ring (§33.1). With
# no file there the plan is the body's own ratings. `run/kernel-limits.json` is the set this loop
# holds, written by rename each time it changes, and `GET /limits` reports it as `kernel`. Both are
# in `run/`, which the drop-in already makes writable for the socket.

# The group is the one §23.4's sandbox starts the commanding package in: every package runs as a
# user of its own, and the socket bound above is given to this group, mode 0660, and to nobody else.
# `install.sh` creates it. The name is `launch::RING_GROUP` in skynetd-io, and a test there holds
# this line to it.

# §33.5's restart rules are `skynetd`'s decision for *packages*. This is not a package: it is the
# process that holds the robot, and a loop that has exited is a robot with nothing writing to the
# drives. It restarts, always, with a delay that is long enough to be visible in a journal and
# short enough that a transient driver fault does not leave a robot limp for a minute.
Restart=always
RestartSec=2s

# No `WatchdogSec` here, and the absence is the decision — `install.sh --check` pins it. A hung
# control loop must hold, not restart: restarting would re-open the driver and begin commanding
# hardware again on the strength of a timer having fired, which §33.5 refuses for a crashed
# driver for exactly this reason (unknown bus state, unknown brake state). The drives' own
# command timeout is the watchdog that matters — a loop that stops writing is a loop whose
# commands go stale and fault — and the supervisor's hang is covered the other way round, by
# the watchdog in `skynetd.service` whose restart is safe because reconciliation is idempotent.

# §40.2: the core running the kernel and the RHAL is isolated at boot, and no package's cpuset may
# include it. This is the other side of that rule — the loop is pinned to it.
#
# The number is the machine's and it is deliberately **not** written here. systemd expands
# `${VARIABLE}` in the `Exec*` lines and nowhere else, so `CPUAffinity=${SKYNET_RT_CPU}` — which is
# what this file said until it was first run on a host — does not read the environment file: it is
# parsed as a CPU range, fails, and is *ignored with a log line nobody reads*. The loop then runs
# on whatever core the scheduler likes and §40.2 holds nowhere, while every surface still says it
# does. `install.sh` resolves `--rt-cpu` into
#
#     /etc/systemd/system/skynetk.service.d/10-install.conf
#
# and `install.sh --check` asks systemd what it actually parsed, so this can never be silent again.

# §23.5's real-time argument, made a scheduling policy rather than a hope. `99` is deliberately not
# used: a task at the top priority that spins cannot be preempted by anything, including the
# watchdog that would notice it.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80

# The loop must not be swapped out mid-cycle, and a page fault on the command path is a missed
# deadline that no amount of headroom explains afterwards.
LimitMEMLOCK=infinity

# It writes the black box and binds the policy socket, and reads the driver. The unit as shipped
# does not need the network — and this line is only true for a driver that does not: the mock, a
# serial bus, a body simulated in the process. **The loop hosts the RHAL driver in-process**, so a
# driver that reaches its robot over IP, CAN or raw Ethernet (every Universal Robots, xArm, Franka,
# Fairino, Lite3, Unitree, Booster, Fourier, Spot, Pudu and MAVLink row, and the CANopen and
# EtherCAT ones) is opened in this namespace, where only a downed loopback exists. Measured on a
# real systemd, not assumed: `connect()` to a controller on the host's own address is
# `ENETUNREACH` from here (DRY-COVERAGE-PLAN.md F185, `packaging/test-install-needs.sh`).
#
# So the namespace is closed by default and opened per robot, by `install.sh`, in the drop-in
# named below and for exactly what the driver's `transport` in `drivers/models.json` says:
# `--driver-transport ip|can|raw` and, for ip, `--driver-address` — `PrivateNetwork=no`, the address
# families that transport needs and no others, and `IPAddressDeny=any` with an `IPAddressAllow=` for
# each controller named. §33.1's argument stands: this process stays small enough to reason about,
# and what it may reach is an explicit list on the robot rather than "everything" or "nothing".
#
# `ProtectSystem=strict` makes the entire hierarchy read-only, so every path this process writes has
# to be named — and `ReadWritePaths=` takes no variable expansion either (§ the note on CPUAffinity
# above). What this file said until its first run was `/run/skynet ${SKYNET_ROOT}/data/blackbox`:
# the first names a directory nothing in this repository has ever created, which is a hard
# `226/NAMESPACE` at every start, and the second was dropped as "not absolute". Neither named
# `<root>/run`, where `--policy-socket` on the ExecStart line binds — so the sandbox was wrong about
# all three paths. `install.sh` writes the resolved pair into the drop-in named above.
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
