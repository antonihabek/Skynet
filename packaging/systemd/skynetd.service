[Unit]
# §9, §33: the supervisor. Reconciles desired state, launches packages as transient units, serves
# the local API and the on-robot console, records events, talks to the Hub.
#
# `After=` and not `Requires=`, and the distinction is §33.1's:
#
#   `skynetd` may crash, hang, leak, be killed by the OOM reaper, or be stopped by an operator, and
#   the robot does not become dangerous — the kernel keeps running, sees no fresh commands, and
#   holds.
#
# A `Requires=skynetk.service` would make that false in the other direction: stopping the loop would
# stop the supervisor, and a robot that lost its fleet management because a driver faulted is a
# robot nobody can ask what happened.
Description=Skynet OS supervisor (§9, §33)
Documentation=file:/usr/share/doc/skynet/skynet-os-architecture.md
After=skynetk.service network.target
Wants=network.target

[Service]
Type=exec
EnvironmentFile=/etc/skynet/skynetd.env
# --lan is the on-robot console (§32.2), and §34.2 refuses a routable address here rather than
# warning about one. --advertise is the label a browse shows (§82); without it the machine's own
# name is used, and without --lan nothing is advertised at all.
#
# `$SKYNET_CONSOLE` carries the **whole argument** and is unbraced, and both halves of that matter.
# systemd substitutes `${VARIABLE}` as a single word even when the variable is empty, so the
# `--lan ${SKYNET_CONSOLE_ADDRESS}` this line used to read passed `--lan ""` on every robot
# installed without a console — which is the default — and the supervisor refuses an empty address
# and exits 1, restarts, and does it again. `$VARIABLE` unbraced splits on whitespace and expands
# to *no* words when it is empty, which is the only way a unit file can say "this flag is absent".
#
# `--config ${SKYNET_DRIVER_CONFIG}` in skynetk.service is deliberately not the same case: that one
# is an opaque string handed to the driver's open(), where empty is a value and means no
# configuration. An address has no empty member.
ExecStart=/usr/bin/skynetd \
    --root ${SKYNET_ROOT} \
    $SKYNET_CONSOLE \
    --advertise ${SKYNET_LABEL} \
    --interval ${SKYNET_INTERVAL_MS}

# §82.4's goodbye, which is the whole reason this line exists. `skynetd` is stopped by a signal and
# handling one needs `unsafe`, which its crate forbids — so a robot switched off cleanly used to stay
# in every browser's cache on the link until the 120-second TTL expired. `ExecStop=` runs **before**
# the signal, while the daemon is still up and still holds its own socket, so it can be asked
# properly: withdraw the mDNS name, seal the black box window with reason `shutdown` (§13), exit.
#
# `-` so a failure here never blocks a stop. A robot that cannot reach its own socket is one whose
# supervisor is already gone, and refusing to stop it would turn a lost goodbye into a hung unit.
#
# The credential is admin (§39.1): this stops the supervisor, and only systemd can start it again.
ExecStop=-/usr/bin/skynet shutdown --socket ${SKYNET_SOCKET} --token ${SKYNET_ADMIN_TOKEN}

# The daemon exits on its own once it has withdrawn and sealed; this is the ceiling on how long
# that may take. A second is the responder's own bound plus the seal, and past it systemd sends the
# signal — which is the state that existed before `ExecStop` did, so the worst case is unchanged.
TimeoutStopSec=15s

# It supervises; it is not supervised by the thing it supervises. A restart is cheap and level-
# triggered reconciliation makes it idempotent (§33.3), so the only question is how long a robot
# goes without fleet management, and the answer should be seconds.
Restart=always
RestartSec=5s

# §40.2: never the isolated core. A supervisor scheduled onto the core running the kernel could
# delay the kernel, and §23.5's real-time argument would be void — which is the same rule packages
# are held to, applied to the process that holds them to it.
#
# The cpuset is not written here and neither are the writable paths below, for the reason
# `skynetk.service` states at length: systemd expands `${VARIABLE}` only in the `Exec*` lines, so a
# `CPUAffinity=${SKYNET_GENERAL_CPUS}` is ignored with a log line and a `ReadWritePaths=`
# `${SKYNET_ROOT}` is dropped as "not absolute". Both were in this file until it was first run on a
# host, and the first of them fails *silently* — a supervisor free to be scheduled onto the
# isolated core, on a robot whose documentation says it cannot be.
#
# `install.sh` resolves `--general-cpus` and `--root` into
#
#     /etc/systemd/system/skynetd.service.d/10-install.conf
#
# and `install.sh --check` asserts that systemd came back with the values.

# It launches transient units through `systemd-run`, so it needs the manager. Everything else it
# touches is under its own root.
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
