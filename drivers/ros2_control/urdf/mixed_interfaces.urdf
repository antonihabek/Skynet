<?xml version="1.0"?>
<!--
  The body §24 could not command, and the file the amendment that fixed it was written from.

  `shoulder` takes `position`; `elbow` takes `velocity`. `ros2_control` is entirely happy with that
  — command interfaces are per joint — and §24's command used to carry **one mode for the whole
  body**. There was no mode in which both joints could be told anything, so the descriptor declared
  none and `write_command` refused whatever it was handed: a perfectly ordinary mobile manipulator,
  uncommandable through this platform.

  §86 is the amendment. The descriptor now declares the **union**, each joint carries its own mode,
  and one `skr_command` commands both. **The robot below is unchanged** — every element, attribute
  and value of it — and the suite that runs against it asserts the opposite of what it used to.
  That is what ratifying an amendment looks like from inside a driver: the fixture stays put and
  the expectations invert. Only this comment moved.

  What has not changed is the rule underneath. Commanding only the joints that happen to match a
  body-wide mode would still be worse than refusing — a body half commanded and half holding is a
  trajectory nobody asked for, §25.2's argument one layer down — so a v1 command against this body
  is refused by name rather than partly applied.
-->
<robot name="mixed_interfaces">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="80" velocity="2.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="60" velocity="3.0"/>
  </joint>

  <ros2_control name="mixed_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="shoulder">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="elbow">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
