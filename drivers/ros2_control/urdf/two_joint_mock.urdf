<?xml version="1.0"?>
<!--
  A two-joint arm behind `mock_components/GenericSystem` — `ros2_control`'s **own** fake hardware
  interface, which is what makes this a substrate rather than a mirror. The fake is theirs; the
  driver under test is ours; neither was written from the other.

  Both joints offer `position` and `velocity` command interfaces, so the intersection §24 needs is
  non-empty and the descriptor declares both modes. `urdf/mixed_interfaces.urdf` beside this one is
  the body where it is empty, which is the case the mapping exists to refuse.

  The `<limit effort>` values are here and are **deliberately not read** by the driver: a URDF
  effort limit is a design value from a CAD model, not a datasheet safety rating (§63.4). Leaving
  them in the file is the point — a reader can see what was available and declined.
-->
<robot name="two_joint_mock">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="80" velocity="2.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="60" velocity="3.0"/>
  </joint>

  <ros2_control name="two_joint_mock_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="shoulder">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
