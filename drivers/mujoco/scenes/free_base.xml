<!--
  A free-floating root with two driven wheels.

  The scene says the machine moves. It does not say whether it rolls, walks or flies, and the
  descriptor's `base` decides whether a base-velocity channel commands motion or is refused — so the
  driver will not open this scene until an operator says which.

  It also starts at rest on the floor rather than dropped above it. A wheeled base dropped 5 cm onto
  a hard contact with a 2 ms timestep diverges, MuJoCo resets it, and the robot appears to teleport
  home — which is the failure the driver's divergence check exists to report, and not one this scene
  should be provoking on every run.
-->
<mujoco model="rolling_base">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <default>
    <joint armature="0.01" damping="0.05"/>
    <geom friction="1 0.01 0.001" solref="0.01 1"/>
  </default>

  <worldbody>
    <light pos="0 0 2"/>
    <geom name="floor" type="plane" size="4 4 0.05"/>
    <body name="chassis" pos="0 0 0.05">
      <freejoint name="root"/>
      <geom name="body" type="box" size="0.12 0.08 0.03" mass="2"/>
      <geom name="skid" type="sphere" size="0.02" pos="-0.1 0 -0.03" mass="0.05"/>
      <body name="left_wheel" pos="0.05 0.09 0">
        <joint name="left_wheel" type="hinge" axis="0 1 0"/>
        <geom name="lw" type="cylinder" size="0.05 0.012" quat="0.7071 0.7071 0 0" mass="0.2"/>
      </body>
      <body name="right_wheel" pos="0.05 -0.09 0">
        <joint name="right_wheel" type="hinge" axis="0 1 0"/>
        <geom name="rw" type="cylinder" size="0.05 0.012" quat="0.7071 0.7071 0 0" mass="0.2"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_wheel" joint="left_wheel" kv="0.5" ctrlrange="-20 20" forcerange="-2 2"/>
    <velocity name="right_wheel" joint="right_wheel" kv="0.5" ctrlrange="-20 20" forcerange="-2 2"/>
  </actuator>
</mujoco>
