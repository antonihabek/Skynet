    {
      "id": "frame-a-stream-name-cut-inside-a-character",
      "note": "The cut the case above is *named* for and does not reach. Nine two-byte characters land the sixteen-byte boundary exactly between two of them, so the back-off loop exits without doing anything and an edition that never wrote one would agree about every byte. Six three-byte characters put the boundary **inside** the sixth: the cut walks back to fifteen and the record is one byte shorter than it could be, which is the whole point — sixteen bytes here would be invalid UTF-8 in the ring, and every reader from then on has to guess.",
      "input": {
        "shape": {
          "joints": 2,
          "channels": 2
        },
        "sequence": "13",
        "mono_ns": "6434",
        "entry": {
          "kind": "frame",
          "observation": "abababababababababababababababababababababababababababababababab",
          "target_ns": "6430",
          "worst_skew_us": 0,
          "streams_omitted": 0,
          "streams_absent": 0,
          "streams": [
            {
              "name": "ああああああ",
              "age_us": 1,
              "stale": false
            }
          ]
        }
      },
      "expected": "{\"hex\":\"\",\"size\":232}"
