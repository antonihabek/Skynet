    {
      "id": "nominal",
      "note": "Booted, homed, kernel live, body present, policy holding its lease. Every rule above `nominal` declined, which is the strongest statement this corpus makes about the ordering: the reason names the last rule standing.",
      "input": {
        "previous": "hold",
        "conditions": {
          "post": "passed",
          "homing": "complete",
          "kernel": "live",
          "rhal": "present",
          "policy": "ready"
        }
      },
      "expected": "{\"changed\":true,\"from\":\"hold\",\"reason\":\"nominal\",\"to\":\"running\",\"warning\":true}"
    },
    {
      "id": "observed-nothing",
      "note": "The most important case in this file. A caller that has observed nothing has established nothing, and every default is the least capable reading — so an empty conditions object is a robot in SAFE with a lost RHAL, not a robot licensed to run by an object literal.",
      "input": {
        "previous": "post",
        "conditions": {}
      },
      "expected": "{\"changed\":true,\"from\":\"post\",\"reason\":\"rhal_lost\",\"to\":\"safe\",\"warning\":false}"
    },
    {
      "id": "observed-nothing-from-running",
      "note": "The same conditions from the other end. Nothing about having been running survives an observation that establishes nothing.",
      "input": {
        "previous": "running",
        "conditions": {}
      },
      "expected": "{\"changed\":true,\"from\":\"running\",\"reason\":\"rhal_lost\",\"to\":\"safe\",\"warning\":false}"
    },
    {
      "id": "rhal-lost",
