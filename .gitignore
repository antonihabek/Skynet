# MuJoCo writes this beside the working directory on a warning.
MUJOCO_LOG.TXT

# The C++ edition's build output.
editions/cpp/build/
editions/c/build/

# The build logs and the Hub's documents are not part of the published operating system.
#
# `PROGRESS.md` and `BUILD-LOG.md` are the session-by-session engineering narrative and stay on
# this machine: they are candid about what is broken and why, which is the right way to keep a log
# and the wrong thing to put on a front page. Keep them backed up somewhere private — they are the
# provenance of every decision in here.
#
# The Hub's architecture and build plan belong to the private repository. They were mirrored here
# while both were private; a public operating system does not carry a marketplace's roadmap.
/PROGRESS.md
/BUILD-LOG.md
/docs/skynet-architecture.md
/docs/skynet-build-plan.md
/robot-overflow-patches/

# Machine-specific agent guidance. It names paths on one maintainer's machine.
/CLAUDE.local.md
/AGENTS.local.md
/drivers/franka/layout_probe
/drivers/franka/layout.json.new
/drivers/unitree/fake_robot
/drivers/unitree/selftest
/drivers/unitree/sim_check

# Build products, named one by one because these directories hold source of the same name.
# Six of them were committed rather than ignored — 19 MB of ELF in a repository whose own rule is
# that a driver is source somebody can rebuild (DRY-COVERAGE-PLAN.md F102).
/drivers/booster/fake_robot
/drivers/booster/selftest
/drivers/x1/fake_x1
/drivers/x1/selftest
/drivers/x1/sim_motion
/drivers/python-host/fixtures/extension_check
/drivers/python-host/fixtures/frame_check
/drivers/python-host/fixtures/stop_check
/drivers/lite3/fake_motion_host
/drivers/lite3/selftest
/drivers/lite3/layout_check
/drivers/lite3/cross_check
/drivers/fairino/fake_controller
/drivers/fairino/selftest
/drivers/fairino/layout_check
/drivers/fairino/cross_check
/drivers/fairino/libskynet_fairino.so

# Project Python environment (Spot gRPC SDK lives here; untracked by design).
.venv/

# Drafts addressed to a vendor or another outside party (an enquiry, a bug report). Kept on this machine and
# never sent, filed or posted by an agent: the owner's standing ruling of 2026-09-28 (AGENTS.md).
/drafts/
